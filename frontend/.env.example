# Copy to .env.local and fill in. .env.local is gitignored.
#
# Firebase web app config for the Crucible project. Console →
# Project settings → General → Your apps → Web app → SDK setup and configuration.
#
# These are NOT secrets — a Firebase web API key identifies the project, it does
# not authorise anything. Access is controlled by Firebase Auth and the
# Firestore rules in backend/deploy/firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=crucible-hack-0725.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=crucible-hack-0725
VITE_FIREBASE_APP_ID=

# Optional. Only needed if the frontend reads Firestore directly (report and
# roadmap live-update via onSnapshot instead of 202-polling).
VITE_FIREBASE_STORAGE_BUCKET=crucible-hack-0725-media
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Where the Vite dev proxy forwards /v1, /health and /readyz.
# Defaults to the deployed Cloud Run service; point at http://localhost:8080 to
# use a locally running backend (needs backend/secrets/key.json).
BACKEND_ORIGIN=https://crucible-backend-103350253775.us-central1.run.app
