# Root ignores. backend/.gitignore covers the same ground for its own tree;
# this is deliberate belt-and-braces, because the single worst mistake this
# repository could make is publishing a service account key.

# --- Credentials. Never commit these. ---
secrets/
**/secrets/
*.key.json
key.json
serviceaccount*.json
*-credentials.json
webapikey.txt
idtoken.txt
**/tok-*.txt
**/*tok.txt

.env
.env.*
!.env.example

# --- Test output: contains generated audio, tokens, and API responses ---
testdata/out/
**/testdata/out/

# --- Build artifacts ---
bin/
*.exe
vendor/
*.test
coverage.*

# --- Deck (documentation/deck): generated output. The generator and facts are
#     committed; the downloaded logos, PowerPoint renders and node_modules are
#     not. The .pptx itself IS committed — it is a submission artifact. ---
node_modules/
documentation/deck/assets/
documentation/deck/render/
~$*.pptx

# --- Editor / OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
BACKEND-FOR-FRONTEND.md 
FRONTEND-PRD.md
BACKEND-FOR-FRONTEND.md
CRUCIBLE-FRONTEND-DESIGN-PRD.md
