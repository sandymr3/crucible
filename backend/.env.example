# Copy to .env for local development. .env is gitignored; .env.example is not.
# On Cloud Run none of this comes from a file — it is set as service env vars,
# and GOOGLE_APPLICATION_CREDENTIALS is deliberately left unset so credentials
# resolve from the attached service account.

# --- Platform ---
GOOGLE_CLOUD_PROJECT=crucible-hack-0725
GCS_BUCKET=crucible-hack-0725-media

# Vertex serves the two model families from DIFFERENT locations. Verified
# against this project on 25 Jul 2026 with `go run ./cmd/regionprobe`:
#   Live native-audio -> us-central1 / us-east4 / europe-west4.
#                        "global" closes the socket with a policy violation.
#   Gemini 3.x text   -> "global" ONLY. us-central1 serves nothing past 2.5.
# These cannot be collapsed into one region.
VERTEX_LIVE_LOCATION=us-central1
VERTEX_REASONING_LOCATION=global

# Local only. Leave UNSET on Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/key.json

APP_ENV=local
PORT=8080
LOG_LEVEL=info

# --- Models (verified available on Vertex, 25 Jul 2026) ---
# Live speech-to-speech. GA. 30 HD voices across 24 languages.
MODEL_LIVE=gemini-live-2.5-flash-native-audio
# Digest, turn evaluation, delivery metrics, roadmap, syllabus.
# The PRD named gemini-3-flash, which now exists only as -preview.
#
# Phase 0 A/B, measured against this project (3 warm runs each, same
# structured span-grading prompt):
#   gemini-3.5-flash  55s / 7.0s / 24s  <- wildly variable, unusable
#   gemini-3.6-flash  4.6s / 4.6s / 4.1s <- stable
# Post-turn evaluation has a 4s budget (PRD §4.4), so 3.5-flash is
# disqualified on latency variance despite being the older, safer choice.
# Both produced correct verdicts and neither emitted a false red; 3.6 grades
# somewhat harsher, which the Phase 4 calibration prompt tunes.
MODEL_REASONING=gemini-3.6-flash
# Hints, labels, cheap fan-out. PRD named gemini-3.1-flash-lite, superseded.
MODEL_CHEAP=gemini-3.5-flash-lite

# --- Credit guardrails (PRD §21.2). All enforced server-side. ---
SESSION_MAX_DURATION_SEC=720
SESSION_IDLE_TIMEOUT_SEC=90
SESSION_WARN_REMAIN_SEC=120
MAX_HINTS_PER_TURN=2
MAX_CONCURRENT_SESSIONS=10
DAILY_SESSION_CAP_PER_USER=5

# --- Live behaviour ---
# manual = client owns the turn boundary via activity_start/activity_end.
# Deterministic, echo-proof, and lets us skip sending silent frames.
# auto = server-side VAD, enables natural barge-in.
LIVE_ACTIVITY_MODE=manual

# How long to wait for a grade before steering with deterministic data instead.
# NOT a silence budget: the interviewer is already acknowledging during this
# window. Must exceed real evaluation latency (measured 6-7s here) or the
# fallback wins every race and the grader's sharp followup question is never used.
INJECTION_DEADLINE_MS=9000

# --- Evaluation ---
# An "incorrect" span below this confidence is rewritten to "unsupported".
# Falsely flagging a correct answer red is the single most damaging failure
# this product can produce.
EVAL_RED_CONFIDENCE_MIN=0.75
# Turns shorter than this are not graded at all.
EVAL_MIN_WORDS=15
# Caps the grader's reasoning tokens. Measured on this project with the full
# evaluation prompt: unbounded thinking took 17.3s, budget 512 takes 3.5-7s.
# The heatmap reveal is a moment the user watches, so this is worth bounding.
# Negative = model default, 0 = no thinking.
EVAL_THINKING_BUDGET=512
